{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "demo",
        "production"
      ]
    },
    "status": {
      "enum": [
        "succeeded"
      ]
    },
    "origin": {
      "enum": [
        "native",
        "mock"
      ]
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "model_reported": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          }
        },
        "required": [
          "name",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "job_id",
    "request_hash",
    "mode",
    "status",
    "origin",
    "tool",
    "model_reported",
    "evidence_ref",
    "outputs"
  ],
  "additionalProperties": false
}
